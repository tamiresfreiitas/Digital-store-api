{
  "name": "digital-store-api",
  "version": "1.0.0",
  "description": "API REST da Digital Store (Node, Express, Sequelize, MySQL, JWT)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "seed": "node scripts/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.0.0",
    "sequelize": "^6.37.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "supertest": "^7.0.0"
  }
}
